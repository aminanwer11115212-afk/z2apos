# Copy this file to .env and fill in your actual Supabase project credentials.
# NEVER commit .env to Git.

SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_URL=https://your-project-id.supabase.co

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Server-only. Required by src/integrations/supabase/client.server.ts — without it
# every admin server function fails (user management, export/import, seed, wipe).
# Bypasses RLS: never expose it to the client and never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
